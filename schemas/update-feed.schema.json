{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinybattery.local/schemas/update-feed.schema.json",
  "title": "TinyBattery Update Feed",
  "description": "A static HTTPS feed listing available package updates.",
  "type": "object",
  "required": ["schemaVersion", "packages"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "url"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "minLength": 1,
            "maxLength": 128
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "version": { "type": "string", "minLength": 1, "maxLength": 64 },
          "minAppVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
          "url": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
          "size": { "type": "integer", "minimum": 1 },
          "notes": { "type": "string", "maxLength": 4000 },
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "devices": { "$ref": "#/$defs/items" },
              "themes": { "$ref": "#/$defs/items" }
            }
          }
        }
      },
      "maxItems": 256
    }
  },
  "$defs": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "version": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      },
      "maxItems": 256
    }
  }
}

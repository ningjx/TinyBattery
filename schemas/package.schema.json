{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinybattery.local/schemas/package.schema.json",
  "title": "TinyBattery Extension Package",
  "description": "A bundle containing device definitions and/or SVG icon themes. Items may be paths or objects with id/version/path.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "minAppVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "author": { "type": "string", "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "devices": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" },
      "maxItems": 256
    },
    "themes": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" },
      "maxItems": 256
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "maxProperties": 32
    }
  },
  "anyOf": [
    { "required": ["devices"] },
    { "required": ["themes"] }
  ],
  "$defs": {
    "item": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 512 },
        {
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1, "maxLength": 512 },
            "id": { "type": "string", "maxLength": 128 },
            "version": { "type": "string", "maxLength": 64 }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinybattery.local/schemas/plugin.schema.json",
  "title": "TinyBattery Plugin Manifest",
  "description": "A plugin folder can contain device definitions, icon themes, and/or a managed plugin entry point.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "maxLength": 4000 },
    "apiVersion": { "type": "string", "maxLength": 32 },
    "assembly": { "type": "string", "minLength": 1, "maxLength": 512 },
    "entryType": { "type": "string", "minLength": 1, "maxLength": 512 },
    "devices": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 512 },
      "maxItems": 256
    },
    "themes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 512 },
      "maxItems": 256
    }
  },
  "allOf": [
    {
      "if": { "required": ["assembly"] },
      "then": { "required": ["entryType"] }
    },
    {
      "if": { "required": ["entryType"] },
      "then": { "required": ["assembly"] }
    }
  ]
}

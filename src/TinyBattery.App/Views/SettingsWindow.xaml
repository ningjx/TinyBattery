<Window x:Class="TinyBattery.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TinyBattery 设置"
        Width="820"
        Height="600"
        MinWidth="780"
        MinHeight="420"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Text="设备与主题" />
        <TextBlock Grid.Row="1"
                   Margin="0,4,0,12"
                   Foreground="#666666"
                   Text="内置定义与 %LOCALAPPDATA%\TinyBattery\devices / themes 下的用户内容会在这里合并显示。" />

        <StackPanel Grid.Row="2"
                    Margin="0,0,0,12"
                    Orientation="Horizontal">
            <TextBlock Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Text="电池图标主题" />
            <ComboBox x:Name="ThemeComboBox"
                      Width="260"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="ThemeComboBox_SelectionChanged" />
            <Image x:Name="ThemePreview"
                   Width="32"
                   Height="32"
                   Margin="10,0,0,0"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </StackPanel>

        <ListBox x:Name="DefinitionsList"
                 Grid.Row="3"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="13" />

        <ScrollViewer Grid.Row="4"
                      Margin="0,12,0,0"
                      MaxHeight="120"
                      VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="DiagnosticsText"
                       Foreground="#666666"
                       TextWrapping="Wrap" />
        </ScrollViewer>

        <StackPanel Grid.Row="5"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <CheckBox x:Name="OverwriteCheckBox"
                      Margin="0,0,14,0"
                      VerticalAlignment="Center"
                      Content="覆盖已有内容" />
            <Button Margin="0,0,8,0"
                    Padding="14,6"
                    Click="OpenPluginFolder_Click"
                    Content="打开插件目录" />
            <Button Margin="0,0,8,0"
                    Padding="14,6"
                    Click="ImportDevice_Click"
                    Content="导入设备" />
            <Button Margin="0,0,8,0"
                    Padding="14,6"
                    Click="ImportThemeFolder_Click"
                    Content="导入主题文件夹" />
            <Button Margin="0,0,8,0"
                    Padding="14,6"
                    Click="ImportThemeArchive_Click"
                    Content="导入主题包" />
            <Button Margin="0,0,8,0"
                    Padding="14,6"
                    Click="ImportPackage_Click"
                    Content="导入扩展包" />
            <Button Padding="14,6"
                    Click="Reload_Click"
                    Content="重新加载" />
        </StackPanel>
    </Grid>
</Window>

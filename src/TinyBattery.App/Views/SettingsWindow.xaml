<Window x:Class="TinyBattery.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TinyBattery 设置"
        Width="940"
        Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        KeyDown="OnWindowKeyDown">
    <Grid Margin="14">
        <Border CornerRadius="16" Background="#000000" Opacity="0.2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  Color="#000000"
                                  Direction="270"
                                  Opacity="0.45"
                                  ShadowDepth="0" />
            </Border.Effect>
        </Border>

        <Border Background="{StaticResource WindowSurfaceBrush}"
                BorderBrush="{StaticResource WindowBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid Margin="12,10,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="42"
                            Height="42"
                            VerticalAlignment="Center"
                            Background="{StaticResource SubtleBrush}"
                            CornerRadius="11">
                        <Image x:Name="HeaderIcon"
                               Width="24"
                               Height="24"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="7,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PageTitle}" Text="TinyBattery" />
                        <TextBlock Margin="1,2,0,0"
                                   Style="{StaticResource Caption}"
                                   Text="设备与主题 · 托盘电量监视器" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Click="About_Click"
                                Content="关于与更新"
                                Style="{StaticResource GhostButton}" />
                        <Button Margin="0,0,2,0"
                                Click="Minimize_Click"
                                Style="{StaticResource CaptionButton}"
                                ToolTip="最小化">
                            <Canvas Width="12" Height="12">
                                <Line X1="1.5"
                                      Y1="6"
                                      X2="10.5"
                                      Y2="6"
                                      Stroke="#555555"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Button>
                        <Button Click="Close_Click"
                                Style="{StaticResource CaptionButton}"
                                ToolTip="关闭">
                            <Canvas Width="12" Height="12">
                                <Line X1="1.5"
                                      Y1="1.5"
                                      X2="10.5"
                                      Y2="10.5"
                                      Stroke="#555555"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <Line X1="10.5"
                                      Y1="1.5"
                                      X2="1.5"
                                      Y2="10.5"
                                      Stroke="#555555"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,9,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="电池图标" />
                            <TextBlock Margin="0,3,0,6"
                                       Style="{StaticResource Caption}"
                                       Text="选择托盘图标使用的外观" />

                            <ListBox x:Name="ThemeList"
                                     Height="232"
                                     SelectionChanged="ThemeList_SelectionChanged"
                                     Style="{StaticResource PlainList}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34"
                                                    Height="34"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource SubtleBrush}"
                                                    CornerRadius="8">
                                                <Image Width="24"
                                                       Height="24"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Source="{Binding Preview}" />
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,1,0,0"
                                                           Style="{StaticResource MetaText}"
                                                           Text="{Binding Subtitle}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Margin="0,6,0,0"
                                    Padding="8"
                                    Background="{StaticResource SubtleBrush}"
                                    BorderBrush="#10000000"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="64"
                                            Height="64"
                                            Background="#FFFFFF"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <Image x:Name="ThemePreview"
                                               Width="46"
                                               Height="46"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="7,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="ThemeNameText"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="ThemeDescriptionText"
                                                   Margin="0,3,0,0"
                                                   MaxHeight="30"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="ThemeMetaText"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource MetaText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="显示设备" />
                                <TextBlock x:Name="DeviceCountText"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MetaText}" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       x:Name="DeviceHintText"
                                       Margin="0,3,0,6"
                                       Style="{StaticResource Caption}"
                                       Text="选择托盘图标显示的设备" />

                            <ScrollViewer Grid.Row="2"
                                          MaxHeight="190"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SlotPanel" />
                            </ScrollViewer>

                            <Border Grid.Row="3"
                                    Height="1"
                                    Margin="0,6"
                                    Background="{StaticResource DividerBrush}" />

                            <Grid Grid.Row="4">
                                <TextBlock FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="已连接设备" />
                                <TextBlock x:Name="LiveCountText"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MetaText}" />
                            </Grid>

                            <ScrollViewer Grid.Row="5"
                                          Margin="0,4,0,0"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="DeviceList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Style="{StaticResource Caption}"
                                                               Text="{Binding Detail}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Accent}"
                                                           Text="{Binding Percent}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="DefinitionCountText"
                                       Grid.Row="6"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource MetaText}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Margin="0,8,2,0"
                        Padding="8"
                        Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="导入与维护" />
                            <CheckBox x:Name="OverwriteCheckBox"
                                      HorizontalAlignment="Right"
                                      Content="覆盖已有内容"
                                      Style="{StaticResource SoftCheckBox}" />
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    Margin="0,6,0,0"
                                    Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Click="ImportPackage_Click"
                                    Content="导入主题或设备…"
                                    Style="{StaticResource SoftButton}" />
                            <Button Margin="0,0,8,0"
                                    Click="OpenPluginFolder_Click"
                                    Content="打开插件目录"
                                    Style="{StaticResource SoftButton}" />
                            <Button Click="Reload_Click"
                                    Content="重新加载"
                                    Style="{StaticResource SoftButton}" />
                        </StackPanel>

                        <Border Grid.Row="2"
                                Margin="0,6,0,0"
                                Padding="8,6"
                                Background="{StaticResource SubtleBrush}"
                                CornerRadius="8">
                            <ScrollViewer MaxHeight="42"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="DiagnosticsText"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

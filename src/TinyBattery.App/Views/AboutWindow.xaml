<Window x:Class="TinyBattery.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于与更新"
        Width="680"
        Height="660"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <Style x:Key="AboutRowButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="12,9">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="{StaticResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="{StaticResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border CornerRadius="16" Background="#000000" Opacity="0.2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  Color="#000000"
                                  Direction="270"
                                  Opacity="0.45"
                                  ShadowDepth="0" />
            </Border.Effect>
        </Border>

        <Border Background="{StaticResource WindowSurfaceBrush}"
                BorderBrush="{StaticResource WindowBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid Margin="24,20,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="TinyBattery" />
                        <TextBlock x:Name="VersionText"
                                   Margin="1,2,0,0"
                                   Style="{StaticResource Caption}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="OnCloseClick"
                            Style="{StaticResource CaptionButton}">
                        <Canvas Width="12" Height="12">
                            <Line X1="1.5" Y1="1.5" X2="10.5" Y2="10.5"
                                  Stroke="#555555" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="10.5" Y1="1.5" X2="1.5" Y2="10.5"
                                  Stroke="#555555" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Button>
                </Grid>

                <TextBlock Grid.Row="1"
                           Margin="1,14,0,0"
                           FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="托盘电量监视器 · 设备与图标主题均由插件提供" />
                <TextBlock Grid.Row="2"
                           Margin="1,6,0,0"
                           FontSize="13"
                           Foreground="#4A4A4A"
                           Text="作者  Ning" />

                <Button Grid.Row="3"
                        Margin="0,14,0,0"
                        Click="OnConfigFolderClick"
                        Style="{StaticResource AboutRowButton}"
                        ToolTip="在资源管理器中打开 TinyBattery 配置目录">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="20" Height="20" Stretch="Uniform">
                            <Canvas Width="20" Height="20">
                                <Path Data="M 2.5,5.4 L 7.8,5.4 L 9.5,7.2 L 17.5,7.2 L 17.5,15.6 L 2.5,15.6 Z"
                                      Fill="Transparent"
                                      Stroke="#555555"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                                <Path Data="M 2.5,8.4 L 17.5,8.4"
                                      Fill="Transparent"
                                      Stroke="#555555"
                                      StrokeThickness="1.2" />
                            </Canvas>
                        </Viewbox>
                        <StackPanel Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="12.5"
                                       Foreground="#24292F"
                                       Text="打开配置目录" />
                            <TextBlock x:Name="ConfigPathText"
                                       Margin="0,1,0,0"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Viewbox Grid.Column="2"
                                 Width="14"
                                 Height="14"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Stretch="Uniform">
                            <Canvas Width="16" Height="16">
                                <Path Data="M 7,3 L 3,3 L 3,13 L 13,13 L 13,9"
                                      Fill="Transparent"
                                      Stroke="#666666"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                                <Path Data="M 8,8 L 14,2 M 9,2 L 14,2 L 14,7"
                                      Fill="Transparent"
                                      Stroke="#666666"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Button>

                <Border Grid.Row="4"
                        Height="1"
                        Margin="0,16"
                        Background="{StaticResource DividerBrush}" />

                <Grid Grid.Row="5">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="更新" />
                    <TextBlock x:Name="AppVersionText"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource MetaText}" />
                </Grid>
                <TextBlock Grid.Row="6"
                           Margin="0,3,0,10"
                           Style="{StaticResource Caption}"
                           Text="从 HTTPS 更新源检查和安装主题、设备包。" />

                <Grid Grid.Row="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Height="31"
                            Padding="9,0"
                            Background="#FFFFFF"
                            BorderBrush="#DEDEDE"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBox x:Name="FeedUrlBox"
                                 VerticalContentAlignment="Center"
                                 FontFamily="{StaticResource AppFontFamily}"
                                 FontSize="12"
                                 BorderThickness="0"
                                 Background="Transparent" />
                    </Border>
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Click="SaveFeed_Click"
                            Content="保存"
                            Style="{StaticResource SoftButton}" />
                </Grid>

                <CheckBox x:Name="StartupCheckBox"
                          Grid.Row="8"
                          Margin="0,9,0,0"
                          Content="启动时检查更新"
                          Click="StartupCheck_Click"
                          Style="{StaticResource SoftCheckBox}" />

                <Border Grid.Row="9"
                        Margin="0,10,0,0"
                        Padding="9,7"
                        VerticalAlignment="Top"
                        Background="{StaticResource SubtleBrush}"
                        CornerRadius="8">
                    <TextBlock x:Name="StatusText"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <ListBox x:Name="UpdatesList"
                         Grid.Row="10"
                         Margin="0,10,0,0"
                         Style="{StaticResource PlainList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               FontSize="12"
                                               Foreground="{Binding Accent}"
                                               Text="{Binding VersionText}" />
                                </Grid>
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding Detail}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="11"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button x:Name="CheckButton"
                            Margin="0,0,8,0"
                            Click="Check_Click"
                            Content="检查更新"
                            Style="{StaticResource SoftButton}" />
                    <Button x:Name="InstallButton"
                            Click="Install_Click"
                            Content="安装选中更新"
                            IsEnabled="False"
                            Style="{StaticResource SoftButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

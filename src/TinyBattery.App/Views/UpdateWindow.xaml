<Window x:Class="TinyBattery.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TinyBattery 更新"
        Width="600"
        Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        KeyDown="OnWindowKeyDown">
    <Grid Margin="14">
        <Border CornerRadius="16" Background="#000000" Opacity="0.2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  Color="#000000"
                                  Direction="270"
                                  Opacity="0.45"
                                  ShadowDepth="0" />
            </Border.Effect>
        </Border>

        <Border Background="{StaticResource WindowSurfaceBrush}"
                BorderBrush="{StaticResource WindowBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid Margin="24,20,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="更新" />
                        <TextBlock x:Name="SubtitleText"
                                   Margin="1,2,0,0"
                                   Style="{StaticResource Caption}"
                                   Text="检查主题和设备定义的远程更新" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="Close_Click"
                            Style="{StaticResource CaptionButton}">
                        <Canvas Width="12" Height="12">
                            <Line X1="1.5" Y1="1.5" X2="10.5" Y2="10.5"
                                  Stroke="#555555" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="10.5" Y1="1.5" X2="1.5" Y2="10.5"
                                  Stroke="#555555" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Button>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,16,0,0"
                        Padding="12"
                        Background="{StaticResource SubtleBrush}"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="更新源" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FeedUrlBox"
                                     Height="30"
                                     Padding="9,5"
                                     VerticalContentAlignment="Center"
                                     FontFamily="{StaticResource AppFontFamily}"
                                     FontSize="12"
                                     BorderBrush="#DEDEDE"
                                     BorderThickness="1"
                                     Background="#FFFFFF" />
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Click="SaveFeed_Click"
                                    Content="保存"
                                    Style="{StaticResource SoftButton}" />
                        </Grid>
                        <CheckBox x:Name="StartupCheckBox"
                                  Margin="0,9,0,0"
                                  Content="启动时检查更新"
                                  Click="StartupCheck_Click"
                                  Style="{StaticResource SoftCheckBox}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Margin="0,12,0,0"
                        Padding="9,7"
                        Background="{StaticResource SubtleBrush}"
                        CornerRadius="8">
                    <TextBlock x:Name="StatusText"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <ListBox x:Name="UpdatesList"
                         Grid.Row="3"
                         Margin="0,12,0,0"
                         Style="{StaticResource PlainList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               FontSize="12"
                                               Foreground="{Binding Accent}"
                                               Text="{Binding VersionText}" />
                                </Grid>
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding Detail}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="4"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button x:Name="CheckButton"
                            Margin="0,0,8,0"
                            Click="Check_Click"
                            Content="检查更新"
                            Style="{StaticResource SoftButton}" />
                    <Button x:Name="InstallButton"
                            Margin="0,0,8,0"
                            Click="Install_Click"
                            Content="安装选中更新"
                            IsEnabled="False"
                            Style="{StaticResource SoftButton}" />
                    <Button Click="Close_Click"
                            Content="关闭"
                            Style="{StaticResource SoftButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

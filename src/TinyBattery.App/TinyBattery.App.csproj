<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>TinyBattery</AssemblyName>
    <RootNamespace>TinyBattery.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.0</Version>
    <Product>TinyBattery</Product>
    <Company>Ning</Company>
    <Description>Tray battery monitor with plugin-provided devices and icon themes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinyBattery.Abstractions\TinyBattery.Abstractions.csproj" />
    <ProjectReference Include="..\TinyBattery.Core\TinyBattery.Core.csproj" />
    <ProjectReference Include="..\TinyBattery.Infrastructure\TinyBattery.Infrastructure.csproj" />
    <ProjectReference Include="..\TinyBattery.Protocols\TinyBattery.Protocols.csproj" />
    <ProjectReference Include="..\TinyBattery.Plugin.Logitech\TinyBattery.Plugin.Logitech.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
    <PackageReference Include="Svg.Skia" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\TinyBattery.Plugin.Logitech\devices\g913-tkl.json"
                      LogicalName="TinyBattery.Bundled.logitech.devices.g913-tkl.json" />
    <EmbeddedResource Include="..\TinyBattery.Plugin.ClassicTheme\themes\classic\theme.json"
                      LogicalName="TinyBattery.Bundled.classic.theme.json" />
    <EmbeddedResource Include="..\TinyBattery.Plugin.ClassicTheme\themes\classic\icon.svg"
                      LogicalName="TinyBattery.Bundled.classic.icon.svg" />
  </ItemGroup>

  <Target Name="ExcludePdbFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                            Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
